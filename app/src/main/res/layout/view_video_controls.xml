<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoControls"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_gravity="bottom"
    android:background="#CC111111"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <Button
        android:id="@+id/videoTogglePlayback"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:contentDescription="@string/video_toggle_playback"
        android:text="@string/video_toggle_playback" />

    <SeekBar
        android:id="@+id/videoSeek"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:contentDescription="@string/video_seek" />

    <TextView
        android:id="@+id/videoTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="88dp"
        android:text="@string/video_time_placeholder"
        android:textColor="@color/white"
        android:textSize="12sp" />

</LinearLayout>
